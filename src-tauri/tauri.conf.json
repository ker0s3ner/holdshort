{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Holdshort",
  "version": "0.28.0",
  "identifier": "com.benaspetronis.holdshort",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Holdshort",
        "width": 1400,
        "height": 900
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk3MkM4NzkwN0Q0OTA0Q0YKUldUUEJFbDlrSWNzbHk2VWVEV205SERHMGtjMzFWMWpQd3pmQzNrV0cvRzdUM1ppWTl4eHFvODkK",
      "endpoints": [
        "https://github.com/ker0s3ner/holdshort/releases/latest/download/latest.json"
      ]
    }
  }
}
